#!/bin/sh
# Drive the app against a running dev hub (bin/rails server on :3000):
# reinstalls the app fresh, issues a pairing code for EVENT (default: the newest
# event), and runs the live-hub UI tests. Usage: bin/e2e [TestName]
set -e
cd "$(dirname "$0")/.."
xcodegen -q
SIM=${SIM:-$(xcrun simctl list devices available | grep -m1 -o 'iPhone [^(]*' | sed 's/ *$//')}
# One line: the code, a roster bib and that racer's name, tab-separated.
INFO=$(cd .. && bin/rails runner '
  event = ENV["EVENT"] ? Event.find(ENV["EVENT"]) : Event.order(:created_at).last
  _, raw = PairingToken.issue!(event:, official: Official.first)
  reg = event.registrations.where.not(bib: nil).includes(:racer).order(:bib).first
  print [ raw, reg&.bib, reg&.racer&.full_name ].join("\t")' 2>/dev/null | tail -1)
CODE=$(printf %s "$INFO" | cut -f1)
BIB=$(printf %s "$INFO" | cut -f2)
NAME=$(printf %s "$INFO" | cut -f3)
xcrun simctl boot "$SIM" 2>/dev/null || true
xcrun simctl uninstall "$SIM" com.ronmiles.timingcapture 2>/dev/null || true
ONLY="-only-testing:TimingCaptureUITests/LiveHubUITests${1:+/$1}"
LOG=$(mktemp -t timing-capture-e2e)
set +e
TEST_RUNNER_HUB_ADDRESS=${HUB_ADDRESS:-http://localhost:3000} TEST_RUNNER_HUB_CODE=$CODE TEST_RUNNER_HUB_BIB=$BIB TEST_RUNNER_HUB_NAME=$NAME \
  xcodebuild test -project TimingCapture.xcodeproj -scheme TimingCapture -destination "platform=iOS Simulator,name=$SIM" \
  -resultBundlePath "$LOG.xcresult" $ONLY > "$LOG" 2>&1
status=$?
set -e
grep -E "(error:|failed|passed|skipped|\*\* TEST)" "$LOG" | grep -v IDESchemeActionSDKRecord | tail -20
echo "Results (screenshots): $LOG.xcresult"
exit $status
